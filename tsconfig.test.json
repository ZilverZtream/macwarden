{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "allowJs": true,
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["test/**/*.ts", "src/**/*.ts", "vitest.config*.ts", "vitest.oracle.config.ts"]
}
