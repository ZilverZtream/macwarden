{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZilverZtream/macwarden/blob/main/schemas/output/macwarden.schema.json",
  "title": "macwarden --json output without a command",
  "description": "Normative source: docs/spec.md, Output > Help and --json. `macwarden --help --json` (ok: true, the general usage lines and every command with its summary), `macwarden --version --json` (ok: true, `{\"version\"}`), or a usage error before any command is known (ok: false, exit 2, step null).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "ok",
    "warnings",
    "result",
    "error"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "command": {
      "const": null
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        },
        {
          "$ref": "#/$defs/version"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "$ref": "#/$defs/result"
              },
              {
                "$ref": "#/$defs/version"
              }
            ]
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "step",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "step": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "warning": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "rootKeyId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "uint64 as a canonical decimal string (range up to 18446744073709551615 is enforced by the decoder)."
    },
    "grade": {
      "enum": [
        "ADMIN",
        "SPEND",
        "OPERATE",
        "RECEIVE",
        "READ",
        "UNASSESSED"
      ]
    },
    "registryEntry": {
      "type": "object",
      "required": [
        "nodePubkey",
        "label",
        "rootKeyId",
        "permissions",
        "caveats",
        "grade",
        "fingerprint",
        "outPath",
        "createdAt",
        "verified",
        "status",
        "revokedAt",
        "revokeEvidence",
        "replaces",
        "replacedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "nodePubkey": {
          "type": "string",
          "pattern": "^0[23][0-9a-fA-F]{64}$"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
        },
        "rootKeyId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "grade": {
          "enum": [
            "ADMIN",
            "SPEND",
            "OPERATE",
            "RECEIVE",
            "READ",
            "UNASSESSED"
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fp:[0-9a-f]{16}$"
        },
        "outPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "revokedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "revokeEvidence": {
          "enum": [
            "rejected",
            "by-id-only",
            null
          ]
        },
        "replaces": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "replacedBy": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fingerprint": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "verified": {
                "const": false
              },
              "outPath": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage",
        "commands"
      ],
      "properties": {
        "usage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^macwarden "
          }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "summary"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z]+$"
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        }
      }
    }
  }
}
