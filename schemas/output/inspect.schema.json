{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "macwarden inspect --json output",
  "description": "The single JSON document `macwarden inspect --json` prints to stdout. Normative source: docs/spec.md, Global conventions > Output and Commands > 1. inspect. A Nostr Wallet Connect (NIP-47) input yields the nwcResult shape; its connection secret never appears. An L402 (formerly LSAT) credential yields the l402Result shape; its preimage and macaroon bytes never appear.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command", "ok", "warnings", "result", "error"],
  "properties": {
    "schema": { "const": 1 },
    "command": { "const": "inspect" },
    "ok": { "type": "boolean" },
    "warnings": {
      "type": "array",
      "items": { "enum": ["unsafe-arg"] },
      "uniqueItems": true
    },
    "result": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/result" }, { "$ref": "#/$defs/nwcResult" }, { "$ref": "#/$defs/l402Result" }, { "$ref": "#/$defs/help" }]
    },
    "error": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": {
        "properties": {
          "result": { "oneOf": [{ "$ref": "#/$defs/result" }, { "$ref": "#/$defs/nwcResult" }, { "$ref": "#/$defs/l402Result" }, { "$ref": "#/$defs/help" }] },
          "error": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "result": { "type": "null" },
          "error": { "$ref": "#/$defs/error" }
        }
      }
    }
  ],
  "$defs": {
    "help": {
      "description": "macwarden inspect --help --json: the command synopsis lines (docs/spec.md, Output > Help).",
      "type": "object", "additionalProperties": false, "required": ["usage"],
      "properties": { "usage": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^macwarden inspect " } } }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "step", "message"],
      "properties": {
        "code": { "enum": [2, 3, 8] },
        "step": {
          "description": "null for exit 2; the input or decoding stage for exit 3; internal for exit 8.",
          "oneOf": [
            { "type": "null" },
            {
              "enum": [
                "input-read",
                "input-form",
                "v2-header",
                "packet",
                "identifier-version",
                "identifier-proto",
                "identifier-limits",
                "identifier-root-key-id",
                "nwc-uri",
                "nwc-wallet-pubkey",
                "nwc-relay",
                "nwc-secret",
                "nwc-lud16",
                "l402-form",
                "l402-preimage",
                "internal"
              ]
            }
          ]
        },
        "message": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "code": { "const": 2 } } },
          "then": { "properties": { "step": { "type": "null" } } }
        },
        {
          "if": { "properties": { "code": { "const": 3 } } },
          "then": { "properties": { "step": { "type": "string", "not": { "const": "internal" } } } }
        },
        {
          "if": { "properties": { "code": { "const": 8 } } },
          "then": { "properties": { "step": { "const": "internal" } } }
        }
      ]
    },
    "rootKeyId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "uint64 as a canonical decimal string (range up to 18446744073709551615 is enforced by the decoder)."
    },
    "fingerprint": { "type": "string", "pattern": "^fp:[0-9a-f]{16}$" },
    "grade": { "enum": ["ADMIN", "SPEND", "OPERATE", "RECEIVE", "READ", "UNASSESSED"] },
    "macaroonWarning": {
      "enum": [
        "root-key-0",
        "trailing-bytes",
        "bad-time-before",
        "identifier-exceeds-bounds",
        "caveats-exceed-bounds",
        "unassessed-uri",
        "unassessed-permission",
        "no-permissions",
        "preimage-exposure"
      ]
    },
    "caveat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["time-before", "ipaddr", "iprange", "lnd-custom", "third-party", "unknown"] },
        "value": { "type": "string" },
        "expired": { "type": "boolean" }
      },
      "if": { "properties": { "type": { "const": "time-before" } } },
      "else": { "properties": { "expired": false } }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "location",
        "rootKeyId",
        "permissions",
        "caveats",
        "grade",
        "reasons",
        "warnings",
        "unassessed",
        "snapshot"
      ],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "location": { "type": ["string", "null"] },
        "rootKeyId": { "$ref": "#/$defs/rootKeyId" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "caveats": { "type": "array", "items": { "$ref": "#/$defs/caveat" } },
        "grade": { "$ref": "#/$defs/grade" },
        "reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/macaroonWarning" }, "uniqueItems": true },
        "unassessed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "snapshot": { "type": "string", "minLength": 1, "description": "LND version the bundled permission snapshot came from, e.g. 0.21.4-beta." }
      },
      "allOf": [
        {
          "if": { "properties": { "grade": { "const": "UNASSESSED" } } },
          "then": { "properties": { "reasons": { "type": "array", "maxItems": 0 } } }
        }
      ]
    },
    "pubkey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nwcResult": {
      "type": "object",
      "additionalProperties": false,
      "description": "NIP-47 connection facts. The grade is always SPEND: permissions and budget are set by the wallet service and are not visible.",
      "required": ["kind", "fingerprint", "walletPubkey", "clientPubkey", "relays", "lud16", "grade", "reasons", "warnings"],
      "properties": {
        "kind": { "const": "nwc" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "walletPubkey": { "$ref": "#/$defs/pubkey" },
        "clientPubkey": { "$ref": "#/$defs/pubkey", "description": "x-only secp256k1 public key derived from the connection secret; wallet services list the connection under it." },
        "relays": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "pattern": "^wss?://" } },
        "lud16": { "type": ["string", "null"] },
        "grade": { "const": "SPEND" },
        "reasons": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "nwc-wallet-side-limits" } },
        "warnings": { "type": "array", "items": { "enum": ["relay-details-removed"] }, "uniqueItems": true }
      }
    },
    "l402Caveat": {
      "type": "object",
      "additionalProperties": false,
      "description": "An L402 caveat as Aperture reads it: condition=value, split at the first '='. A preimage caveat's value is never reported, and a caveat that carries the preimage is withheld.",
      "required": ["type", "condition", "value"],
      "properties": {
        "type": { "enum": ["services", "capabilities", "valid-until", "preimage", "constraint", "third-party", "unknown", "withheld"] },
        "condition": { "type": ["string", "null"] },
        "value": { "type": ["string", "null"] },
        "service": { "type": "string" },
        "until": { "type": "string", "description": "The valid-until instant as RFC 3339 UTC, when it is representable." },
        "expired": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["capabilities", "valid-until"] } } }, "then": { "required": ["service"] }, "else": { "properties": { "service": false } } },
        { "if": { "properties": { "type": { "const": "valid-until" } } }, "else": { "properties": { "expired": false, "until": false } } },
        { "if": { "properties": { "type": { "enum": ["preimage", "withheld"] } } }, "then": { "properties": { "value": { "type": "null" } } }, "else": { "properties": { "value": { "type": "string" } } } },
        { "if": { "properties": { "type": { "enum": ["unknown", "third-party", "withheld"] } } }, "then": { "properties": { "condition": { "type": "null" } } }, "else": { "properties": { "condition": { "type": "string" } } } }
      ]
    },
    "l402Facts": {
      "type": "object",
      "description": "The facts of an L402 credential (docs/spec.md, Commands > 1. inspect, L402 input). access is always service-access: an L402 token pays for access to a service and gives no control of a Lightning node.",
      "required": ["macaroonFingerprint", "macaroons", "form", "scheme", "location", "identifier", "services", "caveats", "preimage", "preimageSource", "status", "expired", "access", "countedAs", "warnings"],
      "properties": {
        "macaroonFingerprint": { "$ref": "#/$defs/fingerprint" },
        "macaroons": { "type": "integer", "minimum": 1, "maximum": 16, "description": "Macaroons the credential carries; the other facts describe the primary one (the first with an L402 identifier, else the first)." },
        "form": { "enum": ["authorization", "challenge", "pair", "macaroon", "token-file"] },
        "scheme": { "enum": ["L402", "LSAT", null] },
        "location": { "type": ["string", "null"] },
        "identifier": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["version", "paymentHash", "tokenId"],
              "properties": {
                "version": { "const": 0 },
                "paymentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "tokenId": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          ]
        },
        "services": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "tier"],
            "properties": { "name": { "type": "string", "minLength": 1 }, "tier": { "type": "string", "pattern": "^[+-]?[0-9]+$" } }
          }
        },
        "caveats": { "type": "array", "items": { "$ref": "#/$defs/l402Caveat" } },
        "preimage": { "enum": ["absent", "matches", "mismatch", "unverifiable"] },
        "preimageSource": { "enum": ["credential", "caveat", null] },
        "status": { "enum": ["live", "expired", "preimage-mismatch", "unpaid"] },
        "expired": { "type": "boolean" },
        "access": { "const": "service-access" },
        "countedAs": { "enum": ["READ", null], "description": "How scan --fail-on counts it: READ when a preimage is present that matches the payment hash or cannot be checked; null otherwise." },
        "warnings": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["trailing-bytes", "caveats-exceed-bounds", "l402-identifier-unrecognized", "l402-bad-services", "l402-bad-valid-until", "l402-bad-preimage-caveat", "l402-caveat-withheld", "l402-token-hash-differs", "l402-several-macaroons"] }
        }
      },
      "allOf": [
        { "if": { "properties": { "form": { "enum": ["authorization", "challenge"] } } }, "then": { "properties": { "scheme": { "enum": ["L402", "LSAT"] } } }, "else": { "properties": { "scheme": { "const": null } } } },
        { "if": { "properties": { "preimage": { "const": "absent" } } }, "then": { "properties": { "preimageSource": { "const": null }, "status": { "const": "unpaid" }, "countedAs": { "const": null } } }, "else": { "properties": { "preimageSource": { "enum": ["credential", "caveat"] } } } },
        { "if": { "properties": { "preimage": { "const": "mismatch" } } }, "then": { "properties": { "status": { "const": "preimage-mismatch" }, "countedAs": { "const": null } } } },
        { "if": { "properties": { "preimage": { "enum": ["matches", "unverifiable"] } } }, "then": { "properties": { "status": { "enum": ["live", "expired"] }, "countedAs": { "const": "READ" } } } },
        { "if": { "properties": { "identifier": { "type": "null" } } }, "then": { "properties": { "preimage": { "enum": ["absent", "unverifiable"] } } }, "else": { "properties": { "preimage": { "enum": ["absent", "matches", "mismatch"] } } } }
      ]
    },
    "l402Result": {
      "description": "L402 credential facts. The preimage and the macaroon bytes never appear. fingerprint covers the canonical macaroon followed by the separately presented preimage; macaroonFingerprint covers the macaroon alone.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/l402Facts" }],
      "required": ["kind", "fingerprint"],
      "properties": { "kind": { "const": "l402" }, "fingerprint": { "$ref": "#/$defs/fingerprint" } },
      "unevaluatedProperties": false
    }
  }
}
