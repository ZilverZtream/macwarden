{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZilverZtream/macwarden/blob/main/schemas/output/verify.schema.json",
  "title": "macwarden verify --json output",
  "description": "Normative source: docs/spec.md, Commands > 11. verify. The facts of the credential, as inspect reports them, plus LND's answer. Exit 1 (ok: true) when the credential is accepted or the rejection is not conclusive; exit 0 when LND conclusively rejects it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "command",
    "ok",
    "warnings",
    "result",
    "error"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "command": {
      "const": "verify"
    },
    "ok": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/result"
        },
        {
          "$ref": "#/$defs/help"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "oneOf": [
              {
                "$ref": "#/$defs/result"
              },
              {
                "$ref": "#/$defs/help"
              }
            ]
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "result": {
            "type": "null"
          },
          "error": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "step",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "step": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "warning": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          }
        }
      ]
    },
    "rootKeyId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "uint64 as a canonical decimal string (range up to 18446744073709551615 is enforced by the decoder)."
    },
    "grade": {
      "enum": [
        "ADMIN",
        "SPEND",
        "OPERATE",
        "RECEIVE",
        "READ",
        "UNASSESSED"
      ]
    },
    "registryEntry": {
      "type": "object",
      "required": [
        "nodePubkey",
        "label",
        "rootKeyId",
        "permissions",
        "caveats",
        "grade",
        "fingerprint",
        "outPath",
        "createdAt",
        "verified",
        "status",
        "revokedAt",
        "revokeEvidence",
        "replaces",
        "replacedBy"
      ],
      "additionalProperties": false,
      "properties": {
        "nodePubkey": {
          "type": "string",
          "pattern": "^0[23][0-9a-fA-F]{64}$"
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
        },
        "rootKeyId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "grade": {
          "enum": [
            "ADMIN",
            "SPEND",
            "OPERATE",
            "RECEIVE",
            "READ",
            "UNASSESSED"
          ]
        },
        "fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fp:[0-9a-f]{16}$"
        },
        "outPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "revoked"
          ]
        },
        "revokedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "revokeEvidence": {
          "enum": [
            "rejected",
            "by-id-only",
            null
          ]
        },
        "replaces": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "replacedBy": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fingerprint": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "verified": {
                "const": false
              },
              "outPath": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^fp:[0-9a-f]{16}$"
    },
    "caveat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "time-before",
            "ipaddr",
            "iprange",
            "lnd-custom",
            "third-party",
            "unknown"
          ]
        },
        "value": {
          "type": "string"
        },
        "expired": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "time-before"
          }
        }
      },
      "else": {
        "properties": {
          "expired": false
        }
      }
    },
    "macaroonWarning": {
      "enum": [
        "root-key-0",
        "trailing-bytes",
        "bad-time-before",
        "identifier-exceeds-bounds",
        "caveats-exceed-bounds",
        "unassessed-uri",
        "unassessed-permission",
        "no-permissions",
        "preimage-exposure"
      ]
    },
    "help": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage"
      ],
      "properties": {
        "usage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^macwarden verify "
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "location",
        "rootKeyId",
        "permissions",
        "caveats",
        "grade",
        "reasons",
        "warnings",
        "unassessed",
        "snapshot",
        "node",
        "status",
        "rejection",
        "conclusive",
        "rootKeyListed",
        "ownCredential",
        "canBake",
        "registry",
        "guidance"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootKeyId": {
          "$ref": "#/$defs/rootKeyId"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "caveats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caveat"
          }
        },
        "grade": {
          "$ref": "#/$defs/grade"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macaroonWarning"
          },
          "uniqueItems": true
        },
        "unassessed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "snapshot": {
          "type": "string",
          "minLength": 1,
          "description": "LND version the bundled permission snapshot came from, e.g. 0.21.4-beta."
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pubkey",
            "alias",
            "network"
          ],
          "properties": {
            "pubkey": {
              "type": "string",
              "pattern": "^0[23][0-9a-fA-F]{64}$"
            },
            "alias": {
              "type": "string"
            },
            "network": {
              "type": "string"
            }
          }
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "rejection": {
          "enum": [
            "root-key-missing",
            "signature-mismatch",
            "expired",
            "other",
            null
          ]
        },
        "conclusive": {
          "type": "boolean"
        },
        "rootKeyListed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ownCredential": {
          "type": "boolean"
        },
        "canBake": {
          "type": "boolean"
        },
        "registry": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "status",
                "match"
              ],
              "properties": {
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "active",
                    "revoked"
                  ]
                },
                "match": {
                  "enum": [
                    "fingerprint",
                    "root-key-id"
                  ]
                }
              }
            }
          ]
        },
        "guidance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "rejection": {
                "const": null
              },
              "conclusive": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "rejection": {
                "enum": [
                  "root-key-missing",
                  "signature-mismatch",
                  "expired",
                  "other"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
